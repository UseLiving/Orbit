# Copy this file to .env and fill in what you need. Everything is optional.

# Port the site runs on
PORT=3000

# PumpPortal API key. Optional. With a key, bonding-curve progress, buys/sells and volume
# update on every trade (PumpPortal charges ~0.01 SOL per 10,000 trade messages).
# Without a key, the board still shows every new launch and migration instantly, and
# market cap / progress / volume refresh every few seconds from DexScreener.
PUMPPORTAL_API_KEY=

# Helius API key (free tier works). Optional but recommended. Turns on:
#  - holder counts (plus faster, more reliable top-10 and dev-holding stats)
#  - watching Meteora (Bags, Believe...) and Raydium LaunchLab launches on-chain
#  - instant names and images for those coins
# Get one at helius.dev. When set, it's also used as the Solana RPC below.
HELIUS_API_KEY=

# Solana RPC (HTTP). Used for safety stats and to send signed trades for wallets that
# can't send on their own. Defaults to Helius if HELIUS_API_KEY is set, else the public RPC.
SOLANA_RPC_URL=
# Websocket for the same RPC (defaults to SOLANA_RPC_URL with ws:// / wss://)
SOLANA_WS_URL=

# Watch Meteora DBC and Raydium LaunchLab programs for new coins (1 = on).
# On by default when HELIUS_API_KEY is set. The public RPC usually can't keep up.
EXTRA_LAUNCHPADS=

# RPC requests per second spent on holder / top 10 / dev stats (default 8 with Helius, 2 without)
SAFETY_RPS=

# IPFS gateway used to read token metadata (name, image, socials)
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Bonding-curve % at which a coin moves from New Pairs to Final Stretch
FINAL_STRETCH_MIN_PROGRESS=50

# Set to 1 to run with a simulated feed (no internet needed, trading switched off)
MOCK=0
